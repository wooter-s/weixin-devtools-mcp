.page {
  padding: 24rpx;
}

.card {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.status-card text,
.form-card text {
  display: block;
  margin-bottom: 8rpx;
}

.section-title {
  margin-bottom: 12rpx;
  font-weight: 600;
}

.duplicate-item {
  width: 100%;
  border: 1rpx solid #d7dce5;
  background: #f8fafc;
}

input,
textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  margin: 10rpx 0;
  padding: 12rpx;
  border: 1rpx solid #aeb7c6;
}

#action-log {
  display: block;
  overflow-wrap: anywhere;
  font-family: monospace;
  font-size: 22rpx;
}
